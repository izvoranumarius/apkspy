<?xml version="1.0" encoding="utf-8"?>
<!-- debug-overrides trusts user-installed CAs (like ApkSpy's) in debug builds;
     the base config trusts only the system store, like a release app. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
